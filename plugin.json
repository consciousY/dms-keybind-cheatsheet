{
  "$schema": "https://danklinux.com/schemas/plugin.json",
  "id": "keybindCheatsheet",
  "name": "Keybind Cheatsheet",
  "description": "Bar pill and Control Center shortcut to open DMS keybind settings and cheatsheet modal",
  "version": "1.0.0",
  "author": "consciousY",
  "type": "composite",
  "capabilities": [
    "dankbar-widget",
    "daemon",
    "control-center"
  ],
  "components": {
    "widget": "./KeybindWidget.qml",
    "daemon": "./KeybindDaemon.qml"
  },
  "settings": "./KeybindSettings.qml",
  "icon": "keyboard",
  "requires_dms": ">=1.0.0",
  "permissions": [
    "settings_read",
    "settings_write"
  ]
}
